an ser le\xeddos por el destinatario autorizado."]},{"titulo":"Seguridad en pagos con tarjeta","image":"assets/img/tarjetas_niubizv1.png","valor":3,"contenido":["Para los pagos con tarjeta de cr\xe9dito y d\xe9bito, utilizamos plataformas de pago seguras como NIUBIZ, la cual cumple con los est\xe1ndares internacionales de seguridad, incluyendo PCI DSS v4.0.1 (Payment Card Industry Data Security Standard), garantizando la m\xe1xima protecci\xf3n, confidencialidad e integridad en el procesamiento, transmisi\xf3n y almacenamiento de datos de tarjetas en sus plataformas de pago.","Adem\xe1s, las transacciones est\xe1n protegidas mediante el protocolo 3-D Secure (como Verified by Visa, Mastercard Identity Check, entre otros). Este sistema a\xf1ade una capa adicional de autenticaci\xf3n durante el proceso de pago, solicitando la validaci\xf3n del titular de la tarjeta a trav\xe9s de su banco, lo que reduce significativamente el riesgo de fraude.","En ning\xfan momento almacenamos los datos completos de su tarjeta de cr\xe9dito en nuestros servidores."]}]}');var u0=u(42509);const iA=["privacidadSeguridad"],N0=le=>({responsive:le}),rA=(le,gn)=>({responsive:le,responsive2:gn});function Vd(le,gn){if(1&le&&(i.j41(0,"div",8),i.nrm(1,"app-sidenav-vertical"),i.k0s()),2&le){const Y=i.XpG();i.Y8G("ngClass",i.eq3(1,N0,Y.isCollapsed))}}function fA(le,gn){if(1&le&&(i.j41(0,"nz-sider",9),i.nrm(1,"app-sidenav-vertical",27),i.k0s()),2&le){const Y=i.XpG();i.Y8G("ngClass",i.l_i(1,rA,Y.isCollapsed,!Y.isCollapsed))}}function RA(le,gn){if(1&le&&(i.j41(0,"div",8),i.nrm(1,"app-sidenav-menu2"),i.k0s()),2&le){const Y=i.XpG();i.Y8G("ngClass",i.eq3(1,N0,Y.isCollapsed))}}function qu(le,gn){if(1&le&&(i.j41(0,"nz-sider",9),i.nrm(1,"app-sidenav-menu2",27),i.k0s()),2&le){const Y=i.XpG();i.Y8G("ngClass",i.l_i(1,rA,Y.isCollapsed,!Y.isCollapsed))}}function BA(le,gn){if(1&le&&(i.j41(0,"div",31),i.nrm(1,"span",32)(2,"br"),i.k0s()),2&le){const Y=gn.$implicit;i.R7$(),i.Y8G("innerHTML",Y,i.npT)}}function Fu(le,